// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Supplier / Vendor ─────────────────────────────────────────

model Vendor {
  id         String   @id @default(cuid())
  authUserId String?  @unique // Supabase auth.users UUID (uuid())
  vendorId   String   @unique // e.g. "BW-49201"
  company    String
  tier       Int      @default(1) // 1 | 2 | 3
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rfqSubmissions RFQSubmission[]
  ppapDocuments  PPAPDocument[]
  cars           CAR[]
  scorecards     SupplierScorecard[]

  @@map("vendors")
}

// ─── RFQ ──────────────────────────────────────────────────────

model RFQSubmission {
  id             String        @id @default(cuid())
  referenceId    String        @unique
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  partNumber     String
  partName       String
  annualVolume   Int
  targetPrice    Decimal       @db.Decimal(10, 2)
  material       String?
  toleranceClass String?
  drawingRef     String?
  requiredBy     DateTime?
  notes          String?
  status         RFQStatus     @default(PENDING)
  submittedAt    DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  documents      RFQDocument[]

  @@map("rfq_submissions")
}

enum RFQStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model RFQDocument {
  id         String        @id @default(cuid())
  rfqId      String
  rfq        RFQSubmission @relation(fields: [rfqId], references: [id])
  fileName   String
  fileType   String
  s3Key      String
  s3Bucket   String
  sizeBytes  Int
  uploadedAt DateTime      @default(now())

  @@map("rfq_documents")
}

// ─── PPAP ─────────────────────────────────────────────────────

model PPAPDocument {
  id         String     @id @default(cuid())
  vendorId   String
  vendor     Vendor     @relation(fields: [vendorId], references: [id])
  name       String
  fileType   String
  s3Key      String
  s3Bucket   String
  sizeBytes  Int
  ppapLevel  Int
  status     PPAPStatus @default(DRAFT)
  uploadedAt DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("ppap_documents")
}

enum PPAPStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// ─── Scorecard ────────────────────────────────────────────────

model SupplierScorecard {
  id             String   @id @default(cuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  period         String // "2024-09"
  qualityPPM     Int
  deliveryOTD    Decimal  @db.Decimal(5, 2)
  responsiveness Int
  documentation  Int
  innovation     Int
  sustainability Int
  overallGrade   String
  createdAt      DateTime @default(now())

  @@unique([vendorId, period])
  @@map("supplier_scorecards")
}

// ─── CAR Workflow ─────────────────────────────────────────────

model CAR {
  id                String      @id @default(cuid())
  referenceId       String      @unique
  vendorId          String
  vendor            Vendor      @relation(fields: [vendorId], references: [id])
  nonConformingPart String
  deviation         String
  affectedQty       Int
  detectedBy        String
  why1              String?
  rootCause         String?
  correctiveActions String?
  preventiveActions String?
  closureNotes      String?
  severity          CARSeverity
  status            CARStatus   @default(OPEN)
  currentStep       Int         @default(1)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  updatedAt         DateTime    @updatedAt

  @@map("cars")
}

enum CARSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum CARStatus {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  CLOSED
}

// ─── Capacity ─────────────────────────────────────────────────

model CapacitySnapshot {
  id          String     @id @default(cuid())
  vendorId    String
  lineId      String
  lineName    String
  oee         Decimal    @db.Decimal(5, 2)
  utilization Decimal    @db.Decimal(5, 2)
  status      LineStatus
  snapshotAt  DateTime   @default(now())

  @@index([vendorId, snapshotAt])
  @@map("capacity_snapshots")
}

enum LineStatus {
  ACTIVE
  MAINTENANCE
  CRITICAL
  OFFLINE
}
